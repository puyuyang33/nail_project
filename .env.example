# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Chicago
STORE_CURRENCY=USD
SKIP_ENV_VALIDATION=false

# PostgreSQL (Docker defaults match docker-compose.yml)
DATABASE_URL=postgresql://lunaria:lunaria@localhost:5432/lunaria?schema=public
DIRECT_URL=postgresql://lunaria:lunaria@localhost:5432/lunaria?schema=public

# Auth.js
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
AUTH_GOOGLE_ADMIN_EMAILS=owner@example.com
AUTH_CREDENTIALS_ENABLED=false
AUTH_PASSWORD_REGISTRATION_ENABLED=false
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
SEED_ADMIN_NAME=Store Owner
SEED_ADMIN_ROTATE_PASSWORD=false
SEED_DEMO_DATA=true

# Stripe test mode
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Lunaria Nail Atelier <orders@example.com>

# Distributed rate limiting
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Vercel Cron
CRON_SECRET=replace-with-at-least-32-random-characters

# Optional feature providers
SMS_PROVIDER=disabled
APPOINTMENT_DEPOSITS_ENABLED=false

# Optional MongoDB document store (MongoDB Atlas M0 can be used for free)
NOSQL_PROVIDER=disabled
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=lunaria
NOSQL_EVENT_RETENTION_DAYS=90
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=lunaria
MONGO_INITDB_ROOT_PASSWORD=local_development_only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PRESS_ON_SET
  SUPPLY
  ACCESSORY
  GIFT_CARD
}

enum InventoryAdjustmentType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  CORRECTION
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  LOST
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BlockedTimeType {
  BREAK
  HOLIDAY
  CLOSURE
  PERSONAL
  OTHER
}

enum AppointmentStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
  EXPIRED
}

enum ContactMethod {
  EMAIL
  SMS
  PHONE
}

enum AppointmentTokenPurpose {
  MANAGE
  CANCEL
  RESCHEDULE
}

enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum WholesaleApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum WebhookStatus {
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id                        String                     @id @default(cuid())
  name                      String?
  email                     String?                    @unique
  emailVerified             DateTime?                  @db.Timestamptz(3)
  image                     String?
  passwordHash              String?
  phone                     String?
  phoneNormalized           String?                    @unique
  preferredLocale           String                     @default("en") @db.VarChar(10)
  role                      UserRole                   @default(CUSTOMER)
  status                    UserStatus                 @default(ACTIVE)
  lastLoginAt               DateTime?                  @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  accounts                  Account[]
  sessions                  Session[]
  addresses                 Address[]
  carts                     Cart[]
  wishlist                  Wishlist?
  orders                    Order[]
  reviews                   Review[]                   @relation("ReviewAuthor")
  reviewsModerated          Review[]                   @relation("ReviewModerator")
  appointments              Appointment[]              @relation("AppointmentCustomer")
  appointmentsCreated       Appointment[]              @relation("AppointmentCreatedBy")
  appointmentChanges        AppointmentStatusHistory[]
  staffProfile              StaffMember?
  inventoryAdjustments      InventoryAdjustment[]
  blockedTimesCreated       BlockedTime[]
  discountRedemptions       DiscountRedemption[]
  newsletterSubscription    NewsletterSubscription?
  wholesaleApplications     WholesaleApplication[]     @relation("WholesaleApplicant")
  wholesaleApplicationsRead WholesaleApplication[]     @relation("WholesaleReviewer")
  settingsUpdated           StoreSetting[]
  auditLogs                 AuditLog[]

  @@index([role, status])
  @@index([createdAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([expires])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String   @default("Address") @db.VarChar(80)
  recipientName     String
  company           String?
  line1             String
  line2             String?
  city              String
  region            String?
  postalCode        String
  countryCode       String   @db.Char(2)
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId, isDefaultShipping])
  @@index([userId, isDefaultBilling])
}

model Product {
  id               String               @id @default(cuid())
  slug             String               @unique @db.VarChar(160)
  type             ProductType
  status           ProductStatus        @default(DRAFT)
  basePrice        Decimal              @db.Decimal(12, 2)
  compareAtPrice   Decimal?             @db.Decimal(12, 2)
  costPrice        Decimal?             @db.Decimal(12, 2)
  currency         String               @default("USD") @db.Char(3)
  taxCategory      String?
  trackInventory   Boolean              @default(true)
  allowBackorder   Boolean              @default(false)
  isCustomizable   Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  requiresShipping Boolean              @default(true)
  metadata         Json?
  publishedAt      DateTime?            @db.Timestamptz(3)
  archivedAt       DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  translations     ProductTranslation[]
  images           ProductImage[]
  variants         ProductVariant[]
  categories       ProductCategory[]
  collections      ProductCollection[]
  tags             ProductTag[]
  discountProducts DiscountProduct[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([isFeatured, status])
  @@index([createdAt])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String  @db.VarChar(10)
  name             String
  shortDescription String?
  description      String
  seoTitle         String?
  seoDescription   String?
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?  @unique
  altText   String
  altTextZh String?
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  sku            String         @unique @db.VarChar(80)
  name           String
  optionValues   Json
  size           String?
  shape          String?
  length         String?
  color          String?
  finish         String?
  setQuantity    Int?
  price          Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?       @db.Decimal(12, 2)
  costPrice      Decimal?       @db.Decimal(12, 2)
  barcode        String?        @unique
  weightGrams    Int?
  isActive       Boolean        @default(true)
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]

  @@unique([productId, position])
  @@index([productId, isActive])
}

model Category {
  id                 String                @id @default(cuid())
  slug               String                @unique @db.VarChar(120)
  parentId           String?
  position           Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  parent             Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]            @relation("CategoryHierarchy")
  translations       CategoryTranslation[]
  products           ProductCategory[]
  discountCategories DiscountCategory[]

  @@index([parentId, position])
  @@index([isActive, position])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         String   @db.VarChar(10)
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
}

model Collection {
  id           String                  @id @default(cuid())
  slug         String                  @unique @db.VarChar(120)
  imageUrl     String?
  position     Int                     @default(0)
  isFeatured   Boolean                 @default(false)
  isActive     Boolean                 @default(true)
  startsAt     DateTime?               @db.Timestamptz(3)
  endsAt       DateTime?               @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  translations CollectionTranslation[]
  products     ProductCollection[]

  @@index([isActive, position])
  @@index([isFeatured, isActive])
}

model CollectionTranslation {
  id             String     @id @default(cuid())
  collectionId   String
  locale         String     @db.VarChar(10)
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@index([locale, name])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model Tag {
  id           String           @id @default(cuid())
  slug         String           @unique @db.VarChar(80)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  translations TagTranslation[]
  products     ProductTag[]
}

model TagTranslation {
  id     String @id @default(cuid())
  tagId  String
  locale String @db.VarChar(10)
  name   String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale, name])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Inventory {
  id               String                @id @default(cuid())
  variantId        String                @unique
  quantityOnHand   Int                   @default(0)
  quantityReserved Int                   @default(0)
  reorderLevel     Int                   @default(0)
  version          Int                   @default(0)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments      InventoryAdjustment[]

  @@index([quantityOnHand, quantityReserved])
}

model InventoryAdjustment {
  id            String                  @id @default(cuid())
  inventoryId   String
  type          InventoryAdjustmentType
  quantityDelta Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  inventory     Inventory               @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy     User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdById])
}

model Cart {
  id               String     @id @default(cuid())
  userId           String?
  sessionTokenHash String?    @unique @db.Char(64)
  status           CartStatus @default(ACTIVE)
  currency         String     @default("USD") @db.Char(3)
  discountId       String?
  expiresAt        DateTime?  @db.Timestamptz(3)
  lastActivityAt   DateTime   @default(now()) @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  discount         Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items            CartItem[]
  order            Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([discountId])
}

model CartItem {
  id                String         @id @default(cuid())
  cartId            String
  variantId         String
  lineKey           String         @db.VarChar(160)
  quantity          Int
  unitPriceSnapshot Decimal        @db.Decimal(12, 2)
  customization     Json?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, lineKey])
  @@index([variantId])
}

model Wishlist {
  id               String         @id @default(cuid())
  userId           String?        @unique
  sessionTokenHash String?        @unique @db.Char(64)
  expiresAt        DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            WishlistItem[]

  @@index([expiresAt])
}

model WishlistItem {
  id           String          @id @default(cuid())
  wishlistId   String
  productId    String
  variantId    String?
  selectionKey String          @db.VarChar(200)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  wishlist     Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, selectionKey])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                      String              @id @default(cuid())
  orderNumber             String              @unique @db.VarChar(40)
  userId                  String?
  cartId                  String?             @unique
  discountId              String?
  status                  OrderStatus         @default(DRAFT)
  paymentStatus           PaymentStatus       @default(PENDING)
  locale                  String              @default("en") @db.VarChar(10)
  currency                String              @default("USD") @db.Char(3)
  customerNameSnapshot    String
  emailSnapshot           String?
  emailNormalized         String?
  phoneSnapshot           String?
  phoneNormalized         String?
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?
  subtotal                Decimal             @db.Decimal(12, 2)
  discountTotal           Decimal             @default(0) @db.Decimal(12, 2)
  shippingTotal           Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal              Decimal             @db.Decimal(12, 2)
  discountCodeSnapshot    String?
  shippingMethodSnapshot  Json?
  customerNote            String?
  internalNote            String?
  placedAt                DateTime?           @db.Timestamptz(3)
  canceledAt              DateTime?           @db.Timestamptz(3)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  user                    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart                    Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  discount                Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  discountRedemption      DiscountRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([emailNormalized, orderNumber])
  @@index([phoneNormalized, orderNumber])
  @@index([discountId])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  lineNumber          Int
  productId           String?
  variantId           String?
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String
  imageUrlSnapshot    String?
  unitPrice           Decimal         @db.Decimal(12, 2)
  quantity            Int
  subtotal            Decimal         @db.Decimal(12, 2)
  discountTotal       Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal         @default(0) @db.Decimal(12, 2)
  total               Decimal         @db.Decimal(12, 2)
  productSnapshot     Json
  customization       Json?
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review              Review?

  @@unique([orderId, lineNumber])
  @@index([productId])
  @@index([variantId])
  @@index([skuSnapshot])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String?
  appointmentId     String?
  provider          PaymentProvider
  providerPaymentId String?
  idempotencyKey    String?         @unique
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  refundedAmount    Decimal         @default(0) @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  paymentMethodType String?
  failureCode       String?
  failureMessage    String?
  providerMetadata  Json?
  processedAt       DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  appointment       Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
  @@index([appointmentId, status])
  @@index([status, createdAt])
}

model Shipment {
  id                      String         @id @default(cuid())
  orderId                 String
  status                  ShipmentStatus @default(PENDING)
  carrier                 String?
  service                 String?
  trackingNumber          String?
  trackingUrl             String?
  shippingAddressSnapshot Json
  labelMetadata           Json?
  shippedAt               DateTime?      @db.Timestamptz(3)
  deliveredAt             DateTime?      @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(3)
  order                   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([carrier, trackingNumber])
  @@index([orderId, status])
  @@index([trackingNumber])
}

model Discount {
  id                 String               @id @default(cuid())
  code               String               @unique @db.VarChar(64)
  name               String
  description        String?
  type               DiscountType
  percentage         Decimal?             @db.Decimal(5, 2)
  amount             Decimal?             @db.Decimal(12, 2)
  currency           String?              @db.Char(3)
  minimumSubtotal    Decimal?             @db.Decimal(12, 2)
  maximumDiscount    Decimal?             @db.Decimal(12, 2)
  usageLimit         Int?
  usageLimitPerEmail Int?
  usageCount         Int                  @default(0)
  isActive           Boolean              @default(false)
  startsAt           DateTime?            @db.Timestamptz(3)
  endsAt             DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  carts              Cart[]
  orders             Order[]
  products           DiscountProduct[]
  categories         DiscountCategory[]
  redemptions        DiscountRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountCategory {
  discountId String
  categoryId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
}

model DiscountRedemption {
  id              String   @id @default(cuid())
  discountId      String
  orderId         String   @unique
  userId          String?
  emailNormalized String?
  amount          Decimal  @db.Decimal(12, 2)
  redeemedAt      DateTime @default(now()) @db.Timestamptz(3)
  discount        Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([discountId, redeemedAt])
  @@index([userId, redeemedAt])
  @@index([emailNormalized, redeemedAt])
}

model Review {
  id              String       @id @default(cuid())
  productId       String
  userId          String?
  orderItemId     String?      @unique
  authorName      String
  authorEmailHash String?      @db.Char(64)
  rating          Int
  title           String?
  body            String
  status          ReviewStatus @default(PENDING)
  isVerified      Boolean      @default(false)
  moderatedById   String?
  moderatedAt     DateTime?    @db.Timestamptz(3)
  adminResponse   String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?        @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: SetNull)
  orderItem       OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy     User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([moderatedById])
}

model Service {
  id                  String               @id @default(cuid())
  slug                String               @unique @db.VarChar(140)
  basePrice           Decimal              @db.Decimal(12, 2)
  currency            String               @default("USD") @db.Char(3)
  durationMinutes     Int
  bufferBeforeMinutes Int                  @default(0)
  bufferAfterMinutes  Int                  @default(0)
  depositAmount       Decimal?             @db.Decimal(12, 2)
  isActive            Boolean              @default(true)
  isBookable          Boolean              @default(true)
  position            Int                  @default(0)
  imageUrl            String?
  metadata            Json?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  translations        ServiceTranslation[]
  staff               StaffService[]
  appointments        Appointment[]

  @@index([isActive, isBookable, position])
}

model ServiceTranslation {
  id               String  @id @default(cuid())
  serviceId        String
  locale           String  @db.VarChar(10)
  name             String
  shortDescription String?
  description      String
  seoTitle         String?
  seoDescription   String?
  service          Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale, name])
}

model StaffMember {
  id           String              @id @default(cuid())
  userId       String?             @unique
  displayName  String
  email        String?             @unique
  phone        String?
  bio          String?
  imageUrl     String?
  isActive     Boolean             @default(true)
  position     Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     StaffService[]
  availability StaffAvailability[]
  blockedTimes BlockedTime[]
  appointments Appointment[]

  @@index([isActive, position])
}

model StaffService {
  staffId                 String
  serviceId               String
  priceOverride           Decimal?    @db.Decimal(12, 2)
  durationOverrideMinutes Int?
  staff                   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service                 Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model StaffAvailability {
  id          String      @id @default(cuid())
  staffId     String
  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int
  validFrom   DateTime?   @db.Date
  validUntil  DateTime?   @db.Date
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek, startMinute, endMinute])
  @@index([staffId, dayOfWeek, isAvailable])
}

model BusinessHours {
  id          String    @id @default(cuid())
  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int
  isOpen      Boolean   @default(true)
  label       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([dayOfWeek, startMinute, endMinute])
  @@index([dayOfWeek, isOpen])
}

model BlockedTime {
  id          String          @id @default(cuid())
  staffId     String?
  type        BlockedTimeType
  startsAt    DateTime        @db.Timestamptz(3)
  endsAt      DateTime        @db.Timestamptz(3)
  reason      String?
  isAllDay    Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  staff       StaffMember?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([staffId, startsAt, endsAt])
  @@index([type, startsAt])
  @@index([createdById])
}

model Appointment {
  id                     String                       @id @default(cuid())
  confirmationNumber     String                       @unique @db.VarChar(40)
  userId                 String?
  serviceId              String
  staffId                String?
  createdById            String?
  rescheduledFromId      String?                      @unique
  status                 AppointmentStatus            @default(PENDING)
  locale                 String                       @default("en") @db.VarChar(10)
  timezone               String
  customerNameSnapshot   String
  emailSnapshot          String?
  emailNormalized        String?
  phoneSnapshot          String?
  phoneNormalized        String?
  preferredContactMethod ContactMethod
  messagingConsent       Boolean                      @default(false)
  serviceNameSnapshot    String
  priceSnapshot          Decimal                      @db.Decimal(12, 2)
  depositAmountSnapshot  Decimal                      @default(0) @db.Decimal(12, 2)
  currency               String                       @default("USD") @db.Char(3)
  durationMinutes        Int
  bufferBeforeMinutes    Int                          @default(0)
  bufferAfterMinutes     Int                          @default(0)
  startAt                DateTime                     @db.Timestamptz(3)
  endAt                  DateTime                     @db.Timestamptz(3)
  reservedStartAt        DateTime                     @db.Timestamptz(3)
  reservedEndAt          DateTime                     @db.Timestamptz(3)
  locationSnapshot       Json
  customerNotes          String?
  internalNotes          String?
  cancellationReason     String?
  canceledAt             DateTime?                    @db.Timestamptz(3)
  completedAt            DateTime?                    @db.Timestamptz(3)
  holdExpiresAt          DateTime?                    @db.Timestamptz(3)
  nextReminderAt         DateTime?                    @db.Timestamptz(3)
  reminderSentAt         DateTime?                    @db.Timestamptz(3)
  reminderAttempts       Int                          @default(0)
  version                Int                          @default(1)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)
  user                   User?                        @relation("AppointmentCustomer", fields: [userId], references: [id], onDelete: SetNull)
  service                Service                      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                  StaffMember?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdBy              User?                        @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rescheduledFrom        Appointment?                 @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo          Appointment?                 @relation("AppointmentReschedule")
  statusHistory          AppointmentStatusHistory[]
  managementTokens       AppointmentManagementToken[]
  payments               Payment[]

  @@index([staffId, reservedStartAt, reservedEndAt, status])
  @@index([status, startAt])
  @@index([userId, startAt])
  @@index([emailNormalized, confirmationNumber])
  @@index([phoneNormalized, confirmationNumber])
  @@index([nextReminderAt, status])
  @@index([serviceId, startAt])
  @@index([createdById])
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String
  sequence      Int
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  note          String?
  changedById   String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([appointmentId, sequence])
  @@index([appointmentId, createdAt])
  @@index([changedById])
}

model AppointmentManagementToken {
  id            String                  @id @default(cuid())
  appointmentId String
  tokenHash     String                  @unique @db.Char(64)
  purpose       AppointmentTokenPurpose @default(MANAGE)
  expiresAt     DateTime                @db.Timestamptz(3)
  lastUsedAt    DateTime?               @db.Timestamptz(3)
  revokedAt     DateTime?               @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  appointment   Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model NewsletterSubscription {
  id              String           @id @default(cuid())
  userId          String?          @unique
  email           String
  emailNormalized String           @unique
  locale          String           @default("en") @db.VarChar(10)
  status          NewsletterStatus @default(PENDING)
  source          String?
  consentText     String?
  consentedAt     DateTime?        @db.Timestamptz(3)
  confirmedAt     DateTime?        @db.Timestamptz(3)
  unsubscribedAt  DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model WholesaleApplication {
  id              String                     @id @default(cuid())
  userId          String?
  businessName    String
  contactName     String
  email           String
  emailNormalized String
  phone           String?
  website         String?
  businessType    String?
  taxId           String?
  countryCode     String                     @db.Char(2)
  estimatedVolume String?
  message         String?
  metadata        Json?
  status          WholesaleApplicationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?                  @db.Timestamptz(3)
  reviewNotes     String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(3)
  user            User?                      @relation("WholesaleApplicant", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy      User?                      @relation("WholesaleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([emailNormalized, createdAt])
  @@index([userId])
  @@index([reviewedById])
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(120)
  category    String   @db.VarChar(80)
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category, isPublic])
  @@index([updatedById])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String   @db.VarChar(100)
  entityType    String   @db.VarChar(100)
  entityId      String?
  requestId     String?
  before        Json?
  after         Json?
  metadata      Json?
  ipAddressHash String?  @db.Char(64)
  userAgent     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@index([createdAt])
}

model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String        @db.VarChar(40)
  externalEventId String        @db.VarChar(255)
  eventType       String        @db.VarChar(120)
  objectId        String?
  payloadHash     String        @db.Char(64)
  status          WebhookStatus @default(PROCESSING)
  attempts        Int           @default(1)
  lastError       String?
  result          Json?
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?     @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([objectId])
  @@index([eventType, receivedAt])
}
